#!/usr/bin/env bash
# swarm — orchestrator-driven agent swarm for herdr + pi
#
#   swarm [start] [--cwd DIR] [--prefix P] [--goal "..."]   open a tab with an orchestrator agent
#   swarm spawn <type> [--name N] [--task "..."] [--scope "a,b"] [--wait]   add a worker pane (from inside a swarm)
#   swarm types [--json]                                    list agent types and where each is defined
#   swarm args <type>                                       inspect the pi flags for an agent type
#   swarm ls                                                live agents in the current swarm tab
#   swarm prompt <name> "<text>" [--wait]                   message a live agent (optionally wait for it)
#   swarm wait <name>... [--timeout MS] [--no-read]         wait for reports; read panes only as fallback
#   swarm close <name>                                      close a worker's pane
#   swarm update [--check]                                  update the install from origin/main (--check exits 10 if available)
#
# Agent types are <type>.md files with a frontmatter block; the first match wins:
#   project   ./.swarm/agents/            (only with SWARM_PROJECT_AGENTS=1)
#   env       $SWARM_AGENTS_DIR/
#   xdg       ${XDG_CONFIG_HOME:-$HOME/.config}/herdr-swarm/agents/
#   built-in  $SWARM_HOME/agents/         (the orchestrator always comes from here)
#   ---
#   description: one line
#   model: provider/model
#   thinking: off|minimal|low|medium|high|xhigh|max
#   use_for: one-line routing hint (defaults to description)
#   caps: edit,edit-tests,git-write,github or none (default: read-only)
#   tools: exact comma-separated tool allowlist (orchestrator only)
#   prompt_mode: replace (orchestrator only; default: append)
#   context_files: off (orchestrator only; disables project context files)
#   test_paths: optional JavaScript test-path regex (tester)
#   skills: name[?][@git-url[#ref]], ...  skills the type needs; ? = optional (see README)
#   ---
# Env overrides: SWARM_MODEL / SWARM_THINKING apply to every agent started.
set -euo pipefail

SWARM_HOME="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
AGENTS_DIR="$SWARM_HOME/agents"

# ---- update (no herdr, pi or jq needed to check/fetch) --------------------------
cmd_update() {
  local check=0 cur new count
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) check=1; shift ;;
      -h|--help) echo "usage: swarm update [--check]"; echo "--check: report only; exits 10 when an update is available, 0 otherwise."; exit 0 ;;
      *) echo "unknown update arg: $1" >&2; exit 2 ;;
    esac
  done
  command -v git >/dev/null || { echo "swarm update: git is required" >&2; exit 1; }
  if [[ "$(git -C "$SWARM_HOME" rev-parse --is-inside-work-tree 2>/dev/null || true)" != true ||
        -n "$(git -C "$SWARM_HOME" rev-parse --show-prefix 2>/dev/null || true)" ]]; then
    echo "swarm update: $SWARM_HOME is not a git clone" >&2; exit 1
  fi
  git -C "$SWARM_HOME" symbolic-ref -q HEAD >/dev/null || {
    echo "swarm update: detached HEAD; switch to a branch first" >&2; exit 1;
  }
  git -C "$SWARM_HOME" remote get-url origin >/dev/null 2>&1 || {
    echo "swarm update: no origin remote configured" >&2; exit 1;
  }
  if ! GIT_TERMINAL_PROMPT=0 git -C "$SWARM_HOME" fetch --quiet origin main; then
    echo "swarm update: couldn't reach origin (or origin/main is unavailable)" >&2; exit 1
  fi
  cur="$(git -C "$SWARM_HOME" rev-parse --short HEAD)"
  new="$(git -C "$SWARM_HOME" rev-parse --short FETCH_HEAD)"
  if [[ "$(git -C "$SWARM_HOME" rev-parse HEAD)" == "$(git -C "$SWARM_HOME" rev-parse FETCH_HEAD)" ]]; then
    echo "Already up to date ($cur)"; exit 0
  fi
  # Nothing new upstream, but the branch is ahead of origin/main: not an error.
  if git -C "$SWARM_HOME" merge-base --is-ancestor FETCH_HEAD HEAD; then
    echo "Already up to date ($cur; local commits ahead of origin/main)"; exit 0
  fi
  echo "Current $cur -> new $new (origin/main)"
  echo "Changelog:"
  git -C "$SWARM_HOME" log --oneline --no-decorate HEAD..FETCH_HEAD | sed -n '1,20p'
  count="$(git -C "$SWARM_HOME" rev-list --count HEAD..FETCH_HEAD)"
  if (( count > 20 )); then echo "… and $((count - 20)) more"; fi
  if ! git -C "$SWARM_HOME" merge-base --is-ancestor HEAD FETCH_HEAD; then
    echo "swarm update: local commits; merge manually" >&2; exit 1
  fi
  (( check )) && exit 10
  # NUL-delimited paths handle spaces/newlines. Include staged edits and every
  # untracked file — including ignored ones, which a fast-forward would silently
  # overwrite. Check directory/file collisions too, not just identical paths.
  # --no-renames keeps both sides of a staged rename visible. Never stash or reset.
  local -a dirty=()
  local dirty_path incoming
  while IFS= read -r -d '' dirty_path; do dirty+=("$dirty_path"); done < <(
    git -C "$SWARM_HOME" diff --name-only --no-renames -z HEAD
    git -C "$SWARM_HOME" ls-files --others -z
  )
  while IFS= read -r -d '' incoming; do
    for dirty_path in ${dirty[@]+"${dirty[@]}"}; do
      if [[ "$incoming" == "$dirty_path" || "$incoming" == "$dirty_path/"* || "$dirty_path" == "$incoming/"* ]]; then
        printf 'swarm update: local changes would be overwritten: %s; merge manually\n' "$dirty_path" >&2
        exit 1
      fi
    done
  done < <(git -C "$SWARM_HOME" diff --name-only --no-renames -z HEAD..FETCH_HEAD)
  if [[ -n "${SWARM_ORCHESTRATOR:-}" || -n "${SWARM_RUN_DIR:-}" ]]; then
    echo "Warning: running inside a swarm; restart running swarms after updating." >&2
  fi
  # The merge may replace this very script. Execute the entire mutating phase in
  # a fresh shell so bash never reads more of the old file after it is rewritten.
  exec bash -c '
    if ! git -C "$1" merge --ff-only FETCH_HEAD; then
      echo "swarm update: fast-forward failed; merge manually" >&2; exit 1
    fi
    echo "Updated $2 -> $3. Restart running swarms to pick up new extensions."
    if ! bash "$1/install.sh"; then
      echo "swarm update: updated, but install.sh failed; re-run it" >&2; exit 1
    fi
  ' swarm-update "$SWARM_HOME" "$cur" "$new"
}

# Dispatch update/help before resolving herdr (or checking other dependencies).
case "${1:-}" in
  update) shift; cmd_update "$@" ;;
  -h|--help|help) sed -n '2,31p' "$0"; exit 0 ;;
esac

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

# ---- herdr binary matching the running server --------------------------------
resolve_herdr() {
  if [[ -n "${HERDR_BIN_PATH:-}" && -x "$HERDR_BIN_PATH" ]]; then echo "$HERDR_BIN_PATH"; return; fi
  if [[ -n "${HERDR_BIN:-}" && -x "$HERDR_BIN" ]]; then echo "$HERDR_BIN"; return; fi
  local srv; srv="$(ps -axo args= 2>/dev/null | awk '/herdr server$/ && !/awk/ {print $1; exit}')"
  if [[ -n "$srv" && -x "$srv" ]]; then echo "$srv"; return; fi
  if command -v herdr >/dev/null 2>&1; then command -v herdr; return; fi
  echo "herdr binary not found" >&2; exit 1
}
H="$(resolve_herdr)"

# ---- agent type files ----------------------------------------------------------
if [[ -n "${SWARM_AGENTS_DIR:-}" && -d "$SWARM_AGENTS_DIR" ]]; then SWARM_AGENTS_DIR="$(cd "$SWARM_AGENTS_DIR" && pwd)"; fi
if [[ -n "${SWARM_SKILLS_DIR:-}" && -d "$SWARM_SKILLS_DIR" ]]; then SWARM_SKILLS_DIR="$(cd "$SWARM_SKILLS_DIR" && pwd)"; fi
PROJECT_DIR="$PWD"   # cmd_start points this at --cwd
TYPE_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
user_agent_dirs() { # "<source> <dir>" lines, highest precedence first (dirs may not exist)
  if [[ "${SWARM_PROJECT_AGENTS:-}" == 1 ]]; then echo "project $PROJECT_DIR/.swarm/agents"; fi
  if [[ -n "${SWARM_AGENTS_DIR:-}" ]]; then echo "env $SWARM_AGENTS_DIR"; fi
  echo "xdg ${XDG_CONFIG_HOME:-$HOME/.config}/herdr-swarm/agents"
}
type_lookup() { # type_lookup <type> -> "<source> <file>"; 1 if undefined. orchestrator is built-in only.
  local src dir
  if [[ "$1" != orchestrator ]]; then
    while read -r src dir; do
      if [[ -f "$dir/$1.md" ]]; then echo "$src $dir/$1.md"; return 0; fi
    done < <(user_agent_dirs)
  fi
  if [[ -f "$AGENTS_DIR/$1.md" ]]; then echo "built-in $AGENTS_DIR/$1.md"; return 0; fi
  return 1
}
type_file() { local l; l="$(type_lookup "$1")" || l="built-in $AGENTS_DIR/$1.md"; echo "${l#* }"; }
type_source() { local l; l="$(type_lookup "$1")" || return 0; echo "${l%% *}"; }
fm() { # fm <file> <key>  -> frontmatter value
  awk -v k="$2" 'NR==1 && $0!="---" {exit} NR>1 && $0=="---" {exit}
                 NR>1 && index($0, k":")==1 {sub(/^[^:]*:[ \t]*/,""); print; exit}' "$1"
}
norm_list() { tr -d ' \t' <<<"$1" | sed 's/^none$//'; }
has_cap() { [[ ",$1," == *",$2,"* ]]; }
scope_label() {
  local caps="$1" label="read-only"
  if has_cap "$caps" edit; then label="edits files"
  elif has_cap "$caps" edit-tests; then label="edits test files only"; fi
  has_cap "$caps" git-write && label+=" + git write"
  has_cap "$caps" github && label+=" + GitHub"
  echo "$label"
}
body() { # body <file> -> prompt without frontmatter
  awk 'NR==1 && $0!="---" {p=1} p {print; next} NR>1 && $0=="---" {p=1}' "$1"
}
list_types() { # unique valid type names across all layers
  local src dir f
  { while read -r src dir; do
      for f in "$dir"/*.md; do if [[ -f "$f" ]]; then basename "$f" .md; fi; done
    done < <(user_agent_dirs)
    for f in "$AGENTS_DIR"/*.md; do if [[ -f "$f" ]]; then basename "$f" .md; fi; done
  } | { grep -E "$TYPE_RE" || true; } | LC_ALL=C sort -u
}
require_type() {
  [[ "$1" =~ $TYPE_RE && -f "$(type_file "$1")" ]] && return 0
  echo "unknown agent type '$1'. Available: $(list_types | grep -v '^orchestrator$' | tr '\n' ' ')" >&2; exit 1
}

# ---- skills --------------------------------------------------------------------
SKILL_RE='^([A-Za-z0-9][A-Za-z0-9._-]*)([?])?(@([^#|[:space:]]+)(#([^|[:space:]]+))?)?$'
skill_dirs() {
  if [[ -n "${SWARM_SKILLS_DIR:-}" ]]; then echo "env $SWARM_SKILLS_DIR"; fi
  echo "xdg ${XDG_CONFIG_HOME:-$HOME/.config}/herdr-swarm/skills"
  echo "agents $HOME/.agents/skills"
  echo "pi $HOME/.pi/agent/skills"
  echo "claude $HOME/.claude/skills"
  return 0
}
skill_install_dir() {
  printf '%s/%s\n' "${SWARM_SKILLS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr-swarm/skills}" "$1"
  return 0
}
skill_env_name() {
  printf 'SWARM_SKILL_%s_DIR\n' "$(printf '%s' "$1" | tr 'a-z' 'A-Z' | tr -c 'A-Z0-9' '_')"
  return 0
}
skill_hint() {
  local dir; dir="$(skill_install_dir "$1")"
  if [[ -n "$2" ]]; then
    printf 'git clone %q %q' "$2" "$dir"
    if [[ -n "$3" ]]; then printf ' && git -C %q checkout %q' "$dir" "$3"; fi
    echo
  else
    printf 'put a directory containing SKILL.md at %q\n' "$dir"
  fi
  return 0
}
skill_status() { # state|name|required|source|ref|dir|from
  local raw entry name optional src ref req dir from found
  raw="$(fm "$1" skills)"
  if [[ -z "$(norm_list "$raw")" ]]; then return 0; fi
  while IFS= read -r entry; do
    if [[ -z "$entry" ]]; then continue; fi
    if [[ "$entry" =~ $SKILL_RE ]]; then
      name="${BASH_REMATCH[1]}"; optional="${BASH_REMATCH[2]:-}"
      src="${BASH_REMATCH[4]:-}"; ref="${BASH_REMATCH[6]:-}"
      req=1; found=0
      if [[ -n "$optional" ]]; then req=0; fi
      while read -r from dir; do
        if [[ -f "$dir/$name/SKILL.md" ]]; then
          printf 'ok|%s|%s|%s|%s|%s|%s\n' "$name" "$req" "$src" "$ref" "$dir/$name" "$from"
          found=1; break
        fi
      done < <(skill_dirs)
      if (( ! found )); then printf 'missing|%s|%s|%s|%s||\n' "$name" "$req" "$src" "$ref"; fi
    else
      printf 'invalid|%s|1||||\n' "$entry"
    fi
  done < <(printf '%s\n' "$raw" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  return 0
}

# ---- helpers -------------------------------------------------------------------
live_names() { "$H" agent list | jq -r '.result.agents[]?.name // empty'; }
unique_name() { # unique_name <base>
  local base="$1" n=2 names; names="$(live_names)"
  grep -qx "$base" <<<"$names" || { echo "$base"; return; }
  while grep -qx "$base-$n" <<<"$names"; do n=$((n+1)); done
  echo "$base-$n"
}
shell_at_prompt() {
  "$H" pane process-info --pane "$1" 2>/dev/null | jq -e '
    .result.process_info as $p
    | ($p.foreground_processes | length) == 1
      and $p.foreground_processes[0].pid == $p.shell_pid
      and ($p.foreground_processes[0].name | test("^-?(zsh|bash|fish|sh)$"))' >/dev/null 2>&1
}
wait_shell() { # wait_shell <pane>
  case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) sleep "${SWARM_SHELL_WAIT:-4}"; return 0 ;; esac
  local i stable=0
  for i in $(seq 1 120); do
    if shell_at_prompt "$1"; then stable=$((stable+1)); [[ $stable -ge 2 ]] && return 0; else stable=0; fi
    sleep 0.5
  done
  return 1
}

# build_pi_args <type> <prompt-file> -> global PI_ARGS array
build_pi_args() {
  local type="$1" promptf="$2" f model thinking caps tools exclude="subagent"
  f="$(type_file "$type")"
  model="${SWARM_MODEL:-$(fm "$f" model)}"
  thinking="${SWARM_THINKING:-$(fm "$f" thinking)}"
  caps="$(norm_list "$(fm "$f" caps)")"
  PI_ARGS=()
  [[ -n "$model" ]] && PI_ARGS+=(--model "$model")
  [[ -n "$thinking" ]] && PI_ARGS+=(--thinking "$thinking")
  PI_ARGS+=(--extension "$SWARM_HOME/extensions/swarm-guard.ts")
  if [[ "$type" == orchestrator ]]; then
    PI_ARGS+=(--extension "$SWARM_HOME/extensions/swarm-orchestrator.ts")
    tools="$(norm_list "$(fm "$f" tools)")"
    [[ -n "$tools" ]] && PI_ARGS+=(--tools "$tools")
  fi
  if ! has_cap "$caps" edit && ! has_cap "$caps" edit-tests; then
    exclude+=",edit,write"
  fi
  PI_ARGS+=(--exclude-tools "$exclude")
  local sk_state sk_name sk_req sk_src sk_ref sk_dir sk_from
  while IFS='|' read -r sk_state sk_name sk_req sk_src sk_ref sk_dir sk_from; do
    if [[ "$sk_state" == ok ]]; then PI_ARGS+=(--skill "$sk_dir"); fi
  done < <(skill_status "$f")
  if [[ "$type" == orchestrator && "$(fm "$f" context_files)" == off ]]; then
    PI_ARGS+=(--no-context-files)
  fi
  if [[ "$type" == orchestrator && "$(fm "$f" prompt_mode)" == replace ]]; then
    PI_ARGS+=(--system-prompt "$promptf")
  else
    PI_ARGS+=(--append-system-prompt "$promptf")
  fi
  if [[ "$type" != orchestrator && -f "$SWARM_HOME/prompts/worker.md" ]]; then
    PI_ARGS+=(--append-system-prompt "$SWARM_HOME/prompts/worker.md")
  fi
  return 0
}

# start_pi <type> <name> <pane> <extra-prompt-file>
start_pi() {
  local type="$1" name="$2" pane="$3" ctx="$4" promptf out attempt
  promptf="$(mktemp -t swarm-prompt.XXXXXX)"; body "$(type_file "$type")" > "$promptf"
  build_pi_args "$type" "$promptf"
  wait_shell "$pane" || echo "  (warning: shell in $pane not confirmed idle, trying anyway)" >&2
  for attempt in 1 2 3 4; do
    if out="$("$H" agent start "$name" --kind pi --pane "$pane" --timeout 60000 -- \
          ${PI_ARGS[@]+"${PI_ARGS[@]}"} --name "$name" \
          --append-system-prompt "$ctx" 2>&1)"; then
      return 0
    fi
    if grep -q agent_pane_busy <<<"$out"; then sleep 2; wait_shell "$pane" || true; else break; fi
  done
  echo "✗ failed to start $name in $pane: $out" >&2; return 1
}

# ==============================================================================
cmd_start() {
  local pi_help; pi_help="$(pi --help 2>&1)" || true
  if ! grep -q -- '--exclude-tools' <<<"$pi_help"; then
    echo "swarm: pi not found or too old for agent scopes (needs --tools/--exclude-tools); install/update pi" >&2
    exit 1
  fi
  local CWD="" PREFIX="" WS="${HERDR_WORKSPACE_ID:-}" GOAL=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd) CWD="$2"; shift 2 ;; --prefix) PREFIX="$2"; shift 2 ;;
      --workspace) WS="$2"; shift 2 ;; --goal) GOAL="$2"; shift 2 ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$WS" ]] || WS="$("$H" workspace list | jq -r '.result.workspaces[] | select(.focused) | .workspace_id')"
  [[ -n "$WS" ]] || { echo "could not determine workspace" >&2; exit 1; }
  if [[ -z "$CWD" ]]; then
    if [[ "${HERDR_ENV:-}" == "1" ]]; then CWD="$PWD"
    else CWD="$("$H" pane current 2>/dev/null | jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty')"; CWD="${CWD:-$HOME}"; fi
  fi
  CWD="$(cd "$CWD" && pwd)"
  PROJECT_DIR="$CWD"
  local PROJECT ORCH; PROJECT="$(basename "$CWD")"; ORCH="${PREFIX}orchestrator"
  if grep -qx "$ORCH" <<<"$(live_names)"; then
    echo "agent '$ORCH' is already live; close that swarm's tab or pass --prefix <p>" >&2; exit 1
  fi

  # Per-run state directory, shared by the orchestrator and every worker it spawns.
  local RUN_BASE RUN_DIR
  RUN_BASE="${SWARM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-swarm}"
  RUN_DIR="$RUN_BASE/runs/${PREFIX}${PROJECT}-$(date +%Y%m%d-%H%M%S)-$$"
  mkdir -p "$RUN_DIR/artifacts"
  # Prune runs older than 14 days, but keep any whose events.jsonl is still fresh.
  local d ev
  for d in "$RUN_BASE/runs"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    find "$d" -maxdepth 0 -mtime +14 -print -quit 2>/dev/null | grep -q . || continue
    ev="$d/events.jsonl"
    if [[ -e "$ev" ]]; then
      find "$ev" -maxdepth 0 -mtime +14 -print -quit 2>/dev/null | grep -q . || continue
    fi
    rm -rf "$d"
  done

  echo "▶ creating swarm tab in $WS ($CWD)"
  local T TAB PANE publish_env=()
  [[ -n "${SWARM_PUBLISH_REQUIRE:-}" ]] && publish_env+=(--env "SWARM_PUBLISH_REQUIRE=$SWARM_PUBLISH_REQUIRE")
  [[ -n "${SWARM_AGENTS_DIR:-}" ]] && publish_env+=(--env "SWARM_AGENTS_DIR=$SWARM_AGENTS_DIR")
  [[ -n "${SWARM_SKILLS_DIR:-}" ]] && publish_env+=(--env "SWARM_SKILLS_DIR=$SWARM_SKILLS_DIR")
  [[ -n "${SWARM_PROJECT_AGENTS:-}" ]] && publish_env+=(--env "SWARM_PROJECT_AGENTS=$SWARM_PROJECT_AGENTS")
  T="$("$H" tab create --workspace "$WS" --cwd "$CWD" --label "swarm:${PREFIX}${PROJECT}" --focus \
        --env "SWARM_HOME=$SWARM_HOME" --env "SWARM_PREFIX=$PREFIX" --env "SWARM_ORCHESTRATOR=$ORCH" \
        --env "SWARM_ROLE=orchestrator" --env "SWARM_CAPS=none" --env "SWARM_NAME=$ORCH" \
        --env "SWARM_RUN_DIR=$RUN_DIR" \
        ${publish_env[@]+"${publish_env[@]}"} \
        --env "PATH=$SWARM_HOME:${PATH}")"
  TAB="$(jq -r .result.tab.tab_id <<<"$T")"; PANE="$(jq -r .result.root_pane.pane_id <<<"$T")"
  "$H" pane rename "$PANE" "$ORCH" >/dev/null

  local ctx; ctx="$(mktemp -t swarm-ctx.XXXXXX.md)"
  {
    echo; echo "# Swarm context (generated)"; echo
    echo "You are \`$ORCH\`, the orchestrator of the swarm in tab \`$TAB\`, project \`$CWD\`."
    [[ -n "$PREFIX" ]] && echo "Agent names in this swarm are prefixed with \`$PREFIX\` (spawn does this automatically)."
    echo "Your only tools are swarm_plan, swarm_spawn, swarm_prompt, swarm_wait, swarm_read, swarm_ls, swarm_types, swarm_close. You have no shell, file, web or GitHub access — delegate."
    echo; echo "## Agent types you can spawn"; echo
    echo "| type | use for | enforced scope | model (thinking) |"; echo "|---|---|---|---|"
    local t f use_for missing
    for t in $(list_types); do
      [[ "$t" == "orchestrator" ]] && continue
      f="$(type_file "$t")"
      use_for="$(fm "$f" use_for)"; use_for="${use_for:-$(fm "$f" description)}"
      missing="$(skill_status "$f" | awk -F'|' '$1!="ok" && $3=="1"{print $2}' | paste -s -d, -)"
      if [[ -n "$missing" ]]; then use_for+=" (unavailable: missing skill $missing)"; fi
      echo "| \`$t\` | $use_for | $(scope_label "$(norm_list "$(fm "$f" caps)")") | $(fm "$f" model) ($(fm "$f" thinking)) |"
    done
  } > "$ctx"

  echo "▶ starting pi as '$ORCH' in $PANE"
  start_pi orchestrator "$ORCH" "$PANE" "$ctx"
  "$H" agent focus "$ORCH" >/dev/null 2>&1 || true
  if [[ -n "$GOAL" ]]; then
    "$H" agent prompt "$ORCH" "$GOAL" >/dev/null; echo "▶ goal handed to $ORCH"
  else
    echo "▶ swarm ready in tab $TAB. Type your goal into the '$ORCH' pane."
  fi
}

# ==============================================================================
cmd_spawn() {
  local TYPE="" NAME="" TASK="" SCOPE="" WAIT=0
  [[ $# -gt 0 && "$1" != --* ]] && { TYPE="$1"; shift; }
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) NAME="$2"; shift 2 ;; --task) TASK="$2"; shift 2 ;; --scope) SCOPE="$2"; shift 2 ;; --wait) WAIT=1; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$TYPE" ]] || { echo "usage: swarm spawn <type> [--name N] [--task \"...\"] [--scope \"a,b\"] [--wait]" >&2; exit 2; }
  require_type "$TYPE"
  [[ "$TYPE" != "orchestrator" ]] || { echo "use 'swarm start' for an orchestrator" >&2; exit 1; }
  local sk_state sk_name sk_req sk_src sk_ref sk_dir sk_from sk_file sk_fail=0 searched=""
  local skill_env=() skill_context=()
  sk_file="$(type_file "$TYPE")"
  while IFS='|' read -r sk_state sk_name sk_req sk_src sk_ref sk_dir sk_from; do
    case "$sk_state" in
      ok)
        skill_env+=(--env "$(skill_env_name "$sk_name")=$sk_dir")
        skill_context+=("- \`$sk_name\`: \`$sk_dir\` (\$$(skill_env_name "$sk_name"))") ;;
      missing)
        if [[ "$sk_req" == 1 ]]; then
          echo "swarm: agent type '$TYPE' requires skill '$sk_name', which is not installed." >&2
          echo "  install: $(skill_hint "$sk_name" "$sk_src" "$sk_ref")" >&2
          sk_fail=1
        else
          echo "  (warning: optional skill '$sk_name' for '$TYPE' is not installed; install: $(skill_hint "$sk_name" "$sk_src" "$sk_ref"))" >&2
        fi ;;
      invalid)
        echo "swarm: agent type '$TYPE' has an invalid skills entry '$sk_name' in $sk_file (expected name[?][@git-url[#ref]])" >&2
        sk_fail=1 ;;
    esac
  done < <(skill_status "$sk_file")
  if (( sk_fail )); then
    while read -r sk_from sk_dir; do searched+="${searched:+, }$sk_dir"; done < <(skill_dirs)
    echo "  searched (first <dir>/<name>/SKILL.md wins): $searched" >&2
    exit 1
  fi
  [[ -n "${HERDR_TAB_ID:-}" ]] || { echo "swarm spawn must run from inside a herdr pane (the orchestrator's)" >&2; exit 1; }

  local PREFIX="${SWARM_PREFIX:-}" ORCH="${SWARM_ORCHESTRATOR:-${SWARM_PREFIX:-}orchestrator}"
  NAME="${NAME:-$(unique_name "${PREFIX}${TYPE}")}"
  grep -qx "$NAME" <<<"$(live_names)" && { echo "agent name '$NAME' already live" >&2; exit 1; }

  # pick the largest pane in this tab; split right if wide, else down
  local L target w h dir
  L="$("$H" pane layout --pane "$HERDR_PANE_ID" | jq -c '.result.layout.panes | max_by(.rect.width * .rect.height)')"
  target="$(jq -r .pane_id <<<"$L")"; w="$(jq -r .rect.width <<<"$L")"; h="$(jq -r .rect.height <<<"$L")"
  if (( w > h * 2 )); then dir=right; else dir=down; fi
  (( w < 70 && h < 18 )) && echo "  (warning: panes are getting small — consider 'swarm close' on finished agents)" >&2

  local PANE caps test_paths verdict allow_tools extra_env=()
  caps="$(norm_list "$(fm "$(type_file "$TYPE")" caps)")"
  test_paths="$(fm "$(type_file "$TYPE")" test_paths)"
  verdict="$(fm "$(type_file "$TYPE")" verdict)"
  allow_tools="$(norm_list "$(fm "$(type_file "$TYPE")" allow_tools)")"
  [[ -n "$test_paths" ]] && extra_env+=(--env "SWARM_TEST_PATH_RE=$test_paths")
  [[ -n "${SWARM_RUN_DIR:-}" ]] && extra_env+=(--env "SWARM_RUN_DIR=$SWARM_RUN_DIR")
  [[ -n "$SCOPE" ]] && extra_env+=(--env "SWARM_WRITE_SCOPE=$SCOPE")
  [[ "$verdict" == required ]] && extra_env+=(--env "SWARM_VERDICT=required")
  [[ -n "$allow_tools" ]] && extra_env+=(--env "SWARM_ALLOW_TOOLS=$allow_tools")
  [[ -n "${SWARM_PUBLISH_REQUIRE:-}" ]] && extra_env+=(--env "SWARM_PUBLISH_REQUIRE=$SWARM_PUBLISH_REQUIRE")
  [[ -n "${SWARM_AGENTS_DIR:-}" ]] && extra_env+=(--env "SWARM_AGENTS_DIR=$SWARM_AGENTS_DIR")
  [[ -n "${SWARM_SKILLS_DIR:-}" ]] && extra_env+=(--env "SWARM_SKILLS_DIR=$SWARM_SKILLS_DIR")
  [[ -n "${SWARM_PROJECT_AGENTS:-}" ]] && extra_env+=(--env "SWARM_PROJECT_AGENTS=$SWARM_PROJECT_AGENTS")
  PANE="$("$H" pane split --pane "$target" --direction "$dir" --ratio 0.5 --cwd "$PWD" --no-focus \
          --env "SWARM_HOME=$SWARM_HOME" --env "SWARM_PREFIX=$PREFIX" --env "SWARM_ORCHESTRATOR=$ORCH" \
          --env "SWARM_ROLE=$TYPE" --env "SWARM_CAPS=${caps:-none}" \
          ${extra_env[@]+"${extra_env[@]}"} ${skill_env[@]+"${skill_env[@]}"} \
          --env "SWARM_NAME=$NAME" --env "PATH=$SWARM_HOME:${PATH}" | jq -r .result.pane.pane_id)"
  "$H" pane rename "$PANE" "$NAME" >/dev/null

  local ctx; ctx="$(mktemp -t swarm-ctx.XXXXXX.md)"
  {
    echo; echo "# Swarm context (generated)"; echo
    echo "Your agent name is \`$NAME\` (type \`$TYPE\`). The orchestrator is \`$ORCH\`; report to it with the \`swarm_report\` tool."
    echo "Working directory: \`$PWD\`."
    echo; echo "## Your enforced scope"; echo
    if has_cap "$caps" edit; then echo "- edit files: yes"
    elif has_cap "$caps" edit-tests; then echo "- edit files: test files only"
    else echo "- edit files: no (read-only)"; fi
    if has_cap "$caps" git-write; then
      echo "- git write ops (commit, branch, stash, reset, checkout...): yes"
    else echo "- git write ops (commit, branch, stash, reset, checkout...): no -> hand off to github"; fi
    if has_cap "$caps" github; then
      echo "- GitHub (gh, push/pull/fetch, GitHub API): yes"
    else echo "- GitHub (gh, push/pull/fetch, GitHub API): no -> hand off to github"; fi
    echo "- spawning/messaging other agents: no — only the orchestrator"
    [[ "$verdict" == required ]] && echo "- your DONE report must set verdict: pass|fail"
    if [[ ${#skill_context[@]} -gt 0 ]]; then
      echo; echo "## Skills for your type"; echo
      printf '%s\n' ${skill_context[@]+"${skill_context[@]}"}
      echo "Read each skill's SKILL.md before using it; skill directories are read-only for you."
    fi
  } > "$ctx"

  start_pi "$TYPE" "$NAME" "$PANE" "$ctx"
  echo "spawned $NAME ($TYPE) in pane $PANE"
  if [[ -n "$TASK" ]]; then
    note_prompt "$NAME"
    "$H" agent prompt "$NAME" "$TASK" >/dev/null; echo "task sent to $NAME"
    (( WAIT )) && cmd_wait "$NAME"
  fi
}

# ==============================================================================
# Waiting. herdr's `agent wait --until idle` is a trap: a finished worker is
# `done`, and a freshly prompted agent is still `idle` for a few seconds before
# its turn starts. So we record herdr's state_change_seq when we send a prompt
# and only accept a settled state after activity (working/blocked seen, or the
# seq advanced through a turn).
SEQ_DIR="${TMPDIR:-/tmp}/swarm-seq"; mkdir -p "$SEQ_DIR"
seq_file() { echo "$SEQ_DIR/${SWARM_ORCHESTRATOR:-orchestrator}.$1"; }
agent_seq() { "$H" agent get "$1" 2>/dev/null | jq -r '.result.agent.state_change_seq // 0'; }
now_ms(){ perl -MTime::HiRes=time -e 'printf "%d", time*1000' 2>/dev/null || echo $(( $(date +%s)*1000 )); }
note_prompt() { # call right BEFORE prompting
  agent_seq "$1" > "$(seq_file "$1")"
  now_ms > "$(seq_file "$1").ts"
}

# wait_settled <name> <seq0> <timeout_ms>  -> 0 settled, 1 gone, 2 timeout
wait_settled() {
  local n="$1" seq0="${2:-0}" tmo="$3" start j st seq act=0; start=$(date +%s)
  while :; do
    j="$("$H" agent get "$n" 2>/dev/null)" || return 1
    st="$(jq -r .result.agent.agent_status <<<"$j")"; seq="$(jq -r '.result.agent.state_change_seq // 0' <<<"$j")"
    case "$st" in
      working) act=1 ;;
      blocked) return 0 ;;
      idle|done) if (( act )) || (( seq - seq0 >= 2 )); then return 0; fi ;;
    esac
    (( ( $(date +%s) - start ) * 1000 >= tmo )) && return 2
    sleep 1
  done
}

# swarm wait <name>... [--timeout MS] [--no-read]
cmd_wait() {
  local TIMEOUT=1800000 NO_READ=0 names=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) TIMEOUT="$2"; shift 2 ;;
      --no-read) NO_READ=1; shift ;;
      *) names+=("$1"); shift ;;
    esac
  done
  [[ ${#names[@]} -gt 0 ]] || { echo "usage: swarm wait <name>... [--timeout MS] [--no-read]" >&2; exit 2; }
  local n st rc=0 seq0 f since report artifact size wait_rc
  for n in "${names[@]}"; do
    f="$(seq_file "$n")"; seq0=0; since=0
    [[ -f "$f.ts" ]] && since="$(cat "$f.ts")"
    if [[ -f "$f" ]]; then seq0="$(cat "$f")"; else
      # no prompt recorded through swarm: trust herdr's settled wait
      "$H" agent wait "$n" --until idle --until done --until blocked --timeout "$TIMEOUT" >/dev/null 2>&1 || { echo "=== $n: wait timed out or agent gone" >&2; rc=1; continue; }
      seq0=-9
    fi
    wait_rc=0
    wait_settled "$n" "$seq0" "$TIMEOUT" || wait_rc=$?
    case $wait_rc in
      1) echo "=== $n: agent gone" >&2; rc=1; continue ;;
      2) echo "=== $n: TIMEOUT after ${TIMEOUT}ms (still $("$H" agent get "$n" | jq -r .result.agent.agent_status))" >&2; rc=1; continue ;;
    esac
    rm -f "$f" "$f.ts"
    st="$("$H" agent get "$n" 2>/dev/null | jq -r .result.agent.agent_status)"
    echo "=== $n: $st"
    [[ "$st" == blocked ]] && echo "(blocked: it is showing a question/approval UI — read it and tell the user)"
    report=""
    if [[ -f "${SWARM_RUN_DIR:-}/events.jsonl" ]]; then
      report="$(jq -cR --arg w "$n" --argjson since "$since" 'fromjson? | select(type=="object" and .t=="report" and .worker==$w and (.ts//0)>=$since) | select((.id|type)=="string" and (.id|test("^[A-Za-z0-9._-]+$")))' "$SWARM_RUN_DIR/events.jsonl" | tail -n1)"
    fi
    if [[ -n "$report" ]]; then
      jq -r '(.kind // "REPORT") + " " + .worker +
        ([if .id != null then "r:" + .id else empty end,
          if .verdict != null then "verdict:" + .verdict else empty end] |
          if length > 0 then " [" + join(" ") + "]" else "" end) + ":"' <<<"$report"
      # Never trust the event's artifact path: derive it from the validated id.
      artifact="$SWARM_RUN_DIR/artifacts/$(jq -r '.id' <<<"$report").md"
      if [[ -f "$artifact" ]]; then
        size="$(wc -c < "$artifact" | tr -d '[:space:]')"
        if (( size <= 8000 )); then
          cat "$artifact"; echo
        else
          printf '(report is %s chars, not inlined) full text: %s — swarm_read {report:"%s"} or context_from:["r:%s"]\n' \
            "$size" "$artifact" "$(jq -r '.id // empty' <<<"$report")" "$(jq -r '.id // empty' <<<"$report")"
        fi
      else
        echo "(report artifact unavailable: $artifact)"
      fi
    else
      echo "(no report since the prompt)"
    fi
    if (( ! NO_READ )) && { [[ -z "$report" ]] || [[ "$st" == blocked ]]; }; then
      "$H" agent read "$n" --source recent-unwrapped --lines 40 2>/dev/null | grep -v '^\s*$' | grep -v '^─*$' || true
    fi
  done
  return $rc
}

# swarm prompt <name> "<text>" [--wait] [--timeout MS]
cmd_prompt() {
  local NAME="" TEXT="" WAIT=0 TIMEOUT=1800000
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) WAIT=1; shift ;; --timeout) TIMEOUT="$2"; shift 2 ;;
      *) if [[ -z "$NAME" ]]; then NAME="$1"; elif [[ -z "$TEXT" ]]; then TEXT="$1"; else echo "unexpected arg: $1" >&2; exit 2; fi; shift ;;
    esac
  done
  [[ -n "$NAME" && -n "$TEXT" ]] || { echo 'usage: swarm prompt <name> "<text>" [--wait] [--timeout MS]' >&2; exit 2; }
  note_prompt "$NAME"
  "$H" agent prompt "$NAME" "$TEXT" >/dev/null || exit 1
  echo "prompt sent to $NAME"
  (( WAIT )) && cmd_wait "$NAME" --timeout "$TIMEOUT"
  return 0
}

# ==============================================================================
cmd_args() {
  [[ $# -eq 1 ]] || { echo "usage: swarm args <type>" >&2; exit 2; }
  require_type "$1"
  local promptf; promptf="$(mktemp -t swarm-prompt.XXXXXX)"
  body "$(type_file "$1")" > "$promptf"
  build_pi_args "$1" "$promptf"
  printf '%s\n' ${PI_ARGS[@]+"${PI_ARGS[@]}"}
  rm -f -- "$promptf"
}

cmd_types() {
  if [[ "${1:-}" == "--json" ]]; then
    local t f caps verdict skills
    for t in $(list_types); do
      [[ "$t" == "orchestrator" ]] && continue
      f="$(type_file "$t")"
      caps="$(norm_list "$(fm "$f" caps)")"; verdict="$(fm "$f" verdict)"
      skills="$(skill_status "$f" | jq -Rn '[inputs | select(length>0) | split("|") as $p | {name:$p[1], required:($p[2]=="1"), source:(($p[3]//"") | if .=="" then null else . end), ref:(($p[4]//"") | if .=="" then null else . end), found:($p[0]=="ok"), path:(($p[5]//"") | if .=="" then null else . end), from:(($p[6]//"") | if .=="" then null else . end)} + (if $p[0]=="invalid" then {error:"invalid"} else {} end)]')"
      jq -n --argjson skills "$skills" --arg type "$t" --arg description "$(fm "$f" description)" \
            --arg use_for "$(fm "$f" use_for)" --arg caps "$caps" --arg verdict "$verdict" \
            --arg model "$(fm "$f" model)" --arg thinking "$(fm "$f" thinking)" \
            --arg source "$(type_source "$t")" \
            '{type:$type, source:$source, description:$description, use_for:$use_for,
              caps:($caps | split(",") | map(select(. != ""))),
              verdict:($verdict == "required"), model:$model, thinking:$thinking,
              skills:$skills, missing:($skills | map(select(.required and (.found|not)) | .name))}'
    done | jq -s '.'
    return 0
  fi
  printf "%-14s %-9s %-44s %s\n" TYPE SOURCE MODEL DESCRIPTION
  local t f sk_state sk_name sk_req sk_src sk_ref sk_dir sk_from requirement
  local missing_lines=()
  for t in $(list_types); do
    f="$(type_file "$t")"
    printf "%-14s %-9s %-44s %s\n" "$t" "$(type_source "$t")" "$(fm "$f" model) ($(fm "$f" thinking))" "$(fm "$f" description)"
    while IFS='|' read -r sk_state sk_name sk_req sk_src sk_ref sk_dir sk_from; do
      case "$sk_state" in
        missing)
          requirement=required
          if [[ "$sk_req" == 0 ]]; then requirement=optional; fi
          missing_lines+=("  $t: $sk_name ($requirement) — install: $(skill_hint "$sk_name" "$sk_src" "$sk_ref")") ;;
        invalid)
          missing_lines+=("  $t: invalid skills entry '$sk_name' (expected name[?][@git-url[#ref]])") ;;
      esac
    done < <(skill_status "$f")
  done
  if [[ ${#missing_lines[@]} -gt 0 ]]; then
    echo; echo "Missing skills:"
    printf '%s\n' ${missing_lines[@]+"${missing_lines[@]}"}
  fi
  return 0
}

cmd_ls() {
  local tab="${HERDR_TAB_ID:-}"
  "$H" agent list | jq -r --arg tab "$tab" '
    .result.agents[] | select(.name != null) | select($tab == "" or .tab_id == $tab)
    | "\(.name)\t\(.agent_status)\t\(.pane_id)"' | column -t
}

cmd_close() {
  [[ $# -eq 1 ]] || { echo "usage: swarm close <name>" >&2; exit 2; }
  local pane; pane="$("$H" agent get "$1" | jq -r .result.agent.pane_id)"
  [[ -n "$pane" && "$pane" != null ]] || { echo "no live agent '$1'" >&2; exit 1; }
  [[ "$1" == "${SWARM_ORCHESTRATOR:-}" ]] && { echo "refusing to close the orchestrator" >&2; exit 1; }
  "$H" pane close "$pane" >/dev/null && echo "closed $1 ($pane)"
}

# ==============================================================================
sub="${1:-start}"; [[ $# -gt 0 ]] && shift || true
case "$sub" in
  start)  cmd_start "$@" ;;
  spawn)  cmd_spawn "$@" ;;
  types)  cmd_types "$@" ;;
  args)   cmd_args "$@" ;;
  ls)     cmd_ls ;;
  wait)   cmd_wait "$@" ;;
  prompt) cmd_prompt "$@" ;;
  close)  cmd_close "$@" ;;
  -h|--help|help) sed -n '2,31p' "$0" ;;
  --*)    cmd_start "$sub" "$@" ;;      # `swarm --goal ...` shorthand
  *)      echo "unknown command: $sub" >&2; sed -n '2,12p' "$0" >&2; exit 2 ;;
esac
