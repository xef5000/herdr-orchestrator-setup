#!/usr/bin/env bash
# swarm — orchestrator-driven agent swarm for herdr + pi
#
#   swarm [start] [--cwd DIR] [--prefix P] [--goal "..."]   open a tab with an orchestrator agent
#   swarm spawn <type> [--name N] [--task "..."] [--scope "a,b"] [--wait]   add a worker pane (from inside a swarm)
#   swarm types [--json]                                    list agent types (agents/*.md)
#   swarm args <type>                                       inspect the pi flags for an agent type
#   swarm ls                                                live agents in the current swarm tab
#   swarm prompt <name> "<text>" [--wait]                   message a live agent (optionally wait for it)
#   swarm wait <name>... [--timeout MS]                     block until each agent settles; print its output
#   swarm close <name>                                      close a worker's pane
#
# Agent types live in agents/<type>.md with a frontmatter block:
#   ---
#   description: one line
#   model: provider/model
#   thinking: off|minimal|low|medium|high|xhigh|max
#   use_for: one-line routing hint (defaults to description)
#   caps: edit,edit-tests,git-write,github or none (default: read-only)
#   tools: exact comma-separated tool allowlist (orchestrator only)
#   prompt_mode: replace (orchestrator only; default: append)
#   context_files: off (orchestrator only; disables project context files)
#   test_paths: optional JavaScript test-path regex (tester)
#   ---
# Env overrides: SWARM_MODEL / SWARM_THINKING apply to every agent started.
set -euo pipefail

SWARM_HOME="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
AGENTS_DIR="$SWARM_HOME/agents"
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

# ---- herdr binary matching the running server --------------------------------
resolve_herdr() {
  if [[ -n "${HERDR_BIN_PATH:-}" && -x "$HERDR_BIN_PATH" ]]; then echo "$HERDR_BIN_PATH"; return; fi
  if [[ -n "${HERDR_BIN:-}" && -x "$HERDR_BIN" ]]; then echo "$HERDR_BIN"; return; fi
  local srv; srv="$(ps -axo args= 2>/dev/null | awk '/herdr server$/ && !/awk/ {print $1; exit}')"
  if [[ -n "$srv" && -x "$srv" ]]; then echo "$srv"; return; fi
  if command -v herdr >/dev/null 2>&1; then command -v herdr; return; fi
  echo "herdr binary not found" >&2; exit 1
}
H="$(resolve_herdr)"

# ---- agent type files ----------------------------------------------------------
type_file() { echo "$AGENTS_DIR/$1.md"; }
fm() { # fm <file> <key>  -> frontmatter value
  awk -v k="$2" 'NR==1 && $0!="---" {exit} NR>1 && $0=="---" {exit}
                 NR>1 && index($0, k":")==1 {sub(/^[^:]*:[ \t]*/,""); print; exit}' "$1"
}
norm_list() { tr -d ' \t' <<<"$1" | sed 's/^none$//'; }
has_cap() { [[ ",$1," == *",$2,"* ]]; }
scope_label() {
  local caps="$1" label="read-only"
  if has_cap "$caps" edit; then label="edits files"
  elif has_cap "$caps" edit-tests; then label="edits test files only"; fi
  has_cap "$caps" git-write && label+=" + git write"
  has_cap "$caps" github && label+=" + GitHub"
  echo "$label"
}
body() { # body <file> -> prompt without frontmatter
  awk 'NR==1 && $0!="---" {p=1} p {print; next} NR>1 && $0=="---" {p=1}' "$1"
}
list_types() { for f in "$AGENTS_DIR"/*.md; do basename "$f" .md; done; }
require_type() {
  [[ -f "$(type_file "$1")" ]] && return 0
  echo "unknown agent type '$1'. Available: $(list_types | grep -v '^orchestrator$' | tr '\n' ' ')" >&2; exit 1
}

# ---- helpers -------------------------------------------------------------------
live_names() { "$H" agent list | jq -r '.result.agents[]?.name // empty'; }
unique_name() { # unique_name <base>
  local base="$1" n=2 names; names="$(live_names)"
  grep -qx "$base" <<<"$names" || { echo "$base"; return; }
  while grep -qx "$base-$n" <<<"$names"; do n=$((n+1)); done
  echo "$base-$n"
}
shell_at_prompt() {
  "$H" pane process-info --pane "$1" 2>/dev/null | jq -e '
    .result.process_info as $p
    | ($p.foreground_processes | length) == 1
      and $p.foreground_processes[0].pid == $p.shell_pid
      and ($p.foreground_processes[0].name | test("^-?(zsh|bash|fish|sh)$"))' >/dev/null 2>&1
}
wait_shell() { # wait_shell <pane>
  case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) sleep "${SWARM_SHELL_WAIT:-4}"; return 0 ;; esac
  local i stable=0
  for i in $(seq 1 120); do
    if shell_at_prompt "$1"; then stable=$((stable+1)); [[ $stable -ge 2 ]] && return 0; else stable=0; fi
    sleep 0.5
  done
  return 1
}

# build_pi_args <type> <prompt-file> -> global PI_ARGS array
build_pi_args() {
  local type="$1" promptf="$2" f model thinking caps tools exclude="subagent"
  f="$(type_file "$type")"
  model="${SWARM_MODEL:-$(fm "$f" model)}"
  thinking="${SWARM_THINKING:-$(fm "$f" thinking)}"
  caps="$(norm_list "$(fm "$f" caps)")"
  PI_ARGS=()
  [[ -n "$model" ]] && PI_ARGS+=(--model "$model")
  [[ -n "$thinking" ]] && PI_ARGS+=(--thinking "$thinking")
  PI_ARGS+=(--extension "$SWARM_HOME/extensions/swarm-guard.ts")
  if [[ "$type" == orchestrator ]]; then
    PI_ARGS+=(--extension "$SWARM_HOME/extensions/swarm-orchestrator.ts")
    tools="$(norm_list "$(fm "$f" tools)")"
    [[ -n "$tools" ]] && PI_ARGS+=(--tools "$tools")
  fi
  if ! has_cap "$caps" edit && ! has_cap "$caps" edit-tests; then
    exclude+=",edit,write"
  fi
  PI_ARGS+=(--exclude-tools "$exclude")
  if [[ "$type" == orchestrator && "$(fm "$f" context_files)" == off ]]; then
    PI_ARGS+=(--no-context-files)
  fi
  if [[ "$type" == orchestrator && "$(fm "$f" prompt_mode)" == replace ]]; then
    PI_ARGS+=(--system-prompt "$promptf")
  else
    PI_ARGS+=(--append-system-prompt "$promptf")
  fi
  if [[ "$type" != orchestrator && -f "$SWARM_HOME/prompts/worker.md" ]]; then
    PI_ARGS+=(--append-system-prompt "$SWARM_HOME/prompts/worker.md")
  fi
  return 0
}

# start_pi <type> <name> <pane> <extra-prompt-file>
start_pi() {
  local type="$1" name="$2" pane="$3" ctx="$4" promptf out attempt
  promptf="$(mktemp -t swarm-prompt.XXXXXX)"; body "$(type_file "$type")" > "$promptf"
  build_pi_args "$type" "$promptf"
  wait_shell "$pane" || echo "  (warning: shell in $pane not confirmed idle, trying anyway)" >&2
  for attempt in 1 2 3 4; do
    if out="$("$H" agent start "$name" --kind pi --pane "$pane" --timeout 60000 -- \
          ${PI_ARGS[@]+"${PI_ARGS[@]}"} --name "$name" \
          --append-system-prompt "$ctx" 2>&1)"; then
      return 0
    fi
    if grep -q agent_pane_busy <<<"$out"; then sleep 2; wait_shell "$pane" || true; else break; fi
  done
  echo "✗ failed to start $name in $pane: $out" >&2; return 1
}

# ==============================================================================
cmd_start() {
  local pi_help; pi_help="$(pi --help 2>&1)" || true
  if ! grep -q -- '--exclude-tools' <<<"$pi_help"; then
    echo "swarm: pi not found or too old for agent scopes (needs --tools/--exclude-tools); install/update pi" >&2
    exit 1
  fi
  local CWD="" PREFIX="" WS="${HERDR_WORKSPACE_ID:-}" GOAL=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd) CWD="$2"; shift 2 ;; --prefix) PREFIX="$2"; shift 2 ;;
      --workspace) WS="$2"; shift 2 ;; --goal) GOAL="$2"; shift 2 ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$WS" ]] || WS="$("$H" workspace list | jq -r '.result.workspaces[] | select(.focused) | .workspace_id')"
  [[ -n "$WS" ]] || { echo "could not determine workspace" >&2; exit 1; }
  if [[ -z "$CWD" ]]; then
    if [[ "${HERDR_ENV:-}" == "1" ]]; then CWD="$PWD"
    else CWD="$("$H" pane current 2>/dev/null | jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty')"; CWD="${CWD:-$HOME}"; fi
  fi
  CWD="$(cd "$CWD" && pwd)"
  local PROJECT ORCH; PROJECT="$(basename "$CWD")"; ORCH="${PREFIX}orchestrator"
  if grep -qx "$ORCH" <<<"$(live_names)"; then
    echo "agent '$ORCH' is already live; close that swarm's tab or pass --prefix <p>" >&2; exit 1
  fi

  # Per-run state directory, shared by the orchestrator and every worker it spawns.
  local RUN_BASE RUN_DIR
  RUN_BASE="${SWARM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-swarm}"
  RUN_DIR="$RUN_BASE/runs/${PREFIX}${PROJECT}-$(date +%Y%m%d-%H%M%S)-$$"
  mkdir -p "$RUN_DIR/artifacts"
  # Prune runs older than 14 days, but keep any whose events.jsonl is still fresh.
  local d ev
  for d in "$RUN_BASE/runs"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    find "$d" -maxdepth 0 -mtime +14 -print -quit 2>/dev/null | grep -q . || continue
    ev="$d/events.jsonl"
    if [[ -e "$ev" ]]; then
      find "$ev" -maxdepth 0 -mtime +14 -print -quit 2>/dev/null | grep -q . || continue
    fi
    rm -rf "$d"
  done

  echo "▶ creating swarm tab in $WS ($CWD)"
  local T TAB PANE publish_env=()
  [[ -n "${SWARM_PUBLISH_REQUIRE:-}" ]] && publish_env+=(--env "SWARM_PUBLISH_REQUIRE=$SWARM_PUBLISH_REQUIRE")
  T="$("$H" tab create --workspace "$WS" --cwd "$CWD" --label "swarm:${PREFIX}${PROJECT}" --focus \
        --env "SWARM_HOME=$SWARM_HOME" --env "SWARM_PREFIX=$PREFIX" --env "SWARM_ORCHESTRATOR=$ORCH" \
        --env "SWARM_ROLE=orchestrator" --env "SWARM_CAPS=none" --env "SWARM_NAME=$ORCH" \
        --env "SWARM_RUN_DIR=$RUN_DIR" \
        ${publish_env[@]+"${publish_env[@]}"} \
        --env "PATH=$SWARM_HOME:${PATH}")"
  TAB="$(jq -r .result.tab.tab_id <<<"$T")"; PANE="$(jq -r .result.root_pane.pane_id <<<"$T")"
  "$H" pane rename "$PANE" "$ORCH" >/dev/null

  local ctx; ctx="$(mktemp -t swarm-ctx.XXXXXX.md)"
  {
    echo; echo "# Swarm context (generated)"; echo
    echo "You are \`$ORCH\`, the orchestrator of the swarm in tab \`$TAB\`, project \`$CWD\`."
    [[ -n "$PREFIX" ]] && echo "Agent names in this swarm are prefixed with \`$PREFIX\` (spawn does this automatically)."
    echo "Your only tools are swarm_spawn, swarm_prompt, swarm_wait, swarm_read, swarm_ls, swarm_types, swarm_close. You have no shell, file, web or GitHub access — delegate."
    echo; echo "## Agent types you can spawn"; echo
    echo "| type | use for | enforced scope | model (thinking) |"; echo "|---|---|---|---|"
    local t f use_for
    for t in $(list_types); do
      [[ "$t" == "orchestrator" ]] && continue
      f="$(type_file "$t")"
      use_for="$(fm "$f" use_for)"; use_for="${use_for:-$(fm "$f" description)}"
      echo "| \`$t\` | $use_for | $(scope_label "$(norm_list "$(fm "$f" caps)")") | $(fm "$f" model) ($(fm "$f" thinking)) |"
    done
  } > "$ctx"

  echo "▶ starting pi as '$ORCH' in $PANE"
  start_pi orchestrator "$ORCH" "$PANE" "$ctx"
  "$H" agent focus "$ORCH" >/dev/null 2>&1 || true
  if [[ -n "$GOAL" ]]; then
    "$H" agent prompt "$ORCH" "$GOAL" >/dev/null; echo "▶ goal handed to $ORCH"
  else
    echo "▶ swarm ready in tab $TAB. Type your goal into the '$ORCH' pane."
  fi
}

# ==============================================================================
cmd_spawn() {
  local TYPE="" NAME="" TASK="" SCOPE="" WAIT=0
  [[ $# -gt 0 && "$1" != --* ]] && { TYPE="$1"; shift; }
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) NAME="$2"; shift 2 ;; --task) TASK="$2"; shift 2 ;; --scope) SCOPE="$2"; shift 2 ;; --wait) WAIT=1; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$TYPE" ]] || { echo "usage: swarm spawn <type> [--name N] [--task \"...\"] [--scope \"a,b\"] [--wait]" >&2; exit 2; }
  require_type "$TYPE"
  [[ "$TYPE" != "orchestrator" ]] || { echo "use 'swarm start' for an orchestrator" >&2; exit 1; }
  [[ -n "${HERDR_TAB_ID:-}" ]] || { echo "swarm spawn must run from inside a herdr pane (the orchestrator's)" >&2; exit 1; }

  local PREFIX="${SWARM_PREFIX:-}" ORCH="${SWARM_ORCHESTRATOR:-${SWARM_PREFIX:-}orchestrator}"
  NAME="${NAME:-$(unique_name "${PREFIX}${TYPE}")}"
  grep -qx "$NAME" <<<"$(live_names)" && { echo "agent name '$NAME' already live" >&2; exit 1; }

  # pick the largest pane in this tab; split right if wide, else down
  local L target w h dir
  L="$("$H" pane layout --pane "$HERDR_PANE_ID" | jq -c '.result.layout.panes | max_by(.rect.width * .rect.height)')"
  target="$(jq -r .pane_id <<<"$L")"; w="$(jq -r .rect.width <<<"$L")"; h="$(jq -r .rect.height <<<"$L")"
  if (( w > h * 2 )); then dir=right; else dir=down; fi
  (( w < 70 && h < 18 )) && echo "  (warning: panes are getting small — consider 'swarm close' on finished agents)" >&2

  local PANE caps test_paths verdict allow_tools extra_env=()
  caps="$(norm_list "$(fm "$(type_file "$TYPE")" caps)")"
  test_paths="$(fm "$(type_file "$TYPE")" test_paths)"
  verdict="$(fm "$(type_file "$TYPE")" verdict)"
  allow_tools="$(norm_list "$(fm "$(type_file "$TYPE")" allow_tools)")"
  [[ -n "$test_paths" ]] && extra_env+=(--env "SWARM_TEST_PATH_RE=$test_paths")
  [[ -n "${SWARM_RUN_DIR:-}" ]] && extra_env+=(--env "SWARM_RUN_DIR=$SWARM_RUN_DIR")
  [[ -n "$SCOPE" ]] && extra_env+=(--env "SWARM_WRITE_SCOPE=$SCOPE")
  [[ "$verdict" == required ]] && extra_env+=(--env "SWARM_VERDICT=required")
  [[ -n "$allow_tools" ]] && extra_env+=(--env "SWARM_ALLOW_TOOLS=$allow_tools")
  [[ -n "${SWARM_PUBLISH_REQUIRE:-}" ]] && extra_env+=(--env "SWARM_PUBLISH_REQUIRE=$SWARM_PUBLISH_REQUIRE")
  PANE="$("$H" pane split --pane "$target" --direction "$dir" --ratio 0.5 --cwd "$PWD" --no-focus \
          --env "SWARM_HOME=$SWARM_HOME" --env "SWARM_PREFIX=$PREFIX" --env "SWARM_ORCHESTRATOR=$ORCH" \
          --env "SWARM_ROLE=$TYPE" --env "SWARM_CAPS=${caps:-none}" \
          ${extra_env[@]+"${extra_env[@]}"} \
          --env "SWARM_NAME=$NAME" --env "PATH=$SWARM_HOME:${PATH}" | jq -r .result.pane.pane_id)"
  "$H" pane rename "$PANE" "$NAME" >/dev/null

  local ctx; ctx="$(mktemp -t swarm-ctx.XXXXXX.md)"
  {
    echo; echo "# Swarm context (generated)"; echo
    echo "Your agent name is \`$NAME\` (type \`$TYPE\`). The orchestrator is \`$ORCH\`; report to it with the \`swarm_report\` tool."
    echo "Working directory: \`$PWD\`."
    echo; echo "## Your enforced scope"; echo
    if has_cap "$caps" edit; then echo "- edit files: yes"
    elif has_cap "$caps" edit-tests; then echo "- edit files: test files only"
    else echo "- edit files: no (read-only)"; fi
    if has_cap "$caps" git-write; then
      echo "- git write ops (commit, branch, stash, reset, checkout...): yes"
    else echo "- git write ops (commit, branch, stash, reset, checkout...): no -> hand off to github"; fi
    if has_cap "$caps" github; then
      echo "- GitHub (gh, push/pull/fetch, GitHub API): yes"
    else echo "- GitHub (gh, push/pull/fetch, GitHub API): no -> hand off to github"; fi
    echo "- spawning/messaging other agents: no — only the orchestrator"
    [[ "$verdict" == required ]] && echo "- your DONE report must set verdict: pass|fail"
  } > "$ctx"

  start_pi "$TYPE" "$NAME" "$PANE" "$ctx"
  echo "spawned $NAME ($TYPE) in pane $PANE"
  if [[ -n "$TASK" ]]; then
    note_prompt "$NAME"
    "$H" agent prompt "$NAME" "$TASK" >/dev/null; echo "task sent to $NAME"
    (( WAIT )) && cmd_wait "$NAME"
  fi
}

# ==============================================================================
# Waiting. herdr's `agent wait --until idle` is a trap: a finished worker is
# `done`, and a freshly prompted agent is still `idle` for a few seconds before
# its turn starts. So we record herdr's state_change_seq when we send a prompt
# and only accept a settled state after activity (working/blocked seen, or the
# seq advanced through a turn).
SEQ_DIR="${TMPDIR:-/tmp}/swarm-seq"; mkdir -p "$SEQ_DIR"
seq_file() { echo "$SEQ_DIR/${SWARM_ORCHESTRATOR:-orchestrator}.$1"; }
agent_seq() { "$H" agent get "$1" 2>/dev/null | jq -r '.result.agent.state_change_seq // 0'; }
note_prompt() { agent_seq "$1" > "$(seq_file "$1")"; }   # call right BEFORE prompting

# wait_settled <name> <seq0> <timeout_ms>  -> 0 settled, 1 gone, 2 timeout
wait_settled() {
  local n="$1" seq0="${2:-0}" tmo="$3" start j st seq act=0; start=$(date +%s)
  while :; do
    j="$("$H" agent get "$n" 2>/dev/null)" || return 1
    st="$(jq -r .result.agent.agent_status <<<"$j")"; seq="$(jq -r '.result.agent.state_change_seq // 0' <<<"$j")"
    case "$st" in
      working) act=1 ;;
      blocked) return 0 ;;
      idle|done) if (( act )) || (( seq - seq0 >= 2 )); then return 0; fi ;;
    esac
    (( ( $(date +%s) - start ) * 1000 >= tmo )) && return 2
    sleep 1
  done
}

# swarm wait <name>... [--timeout MS]
cmd_wait() {
  local TIMEOUT=1800000 names=()
  while [[ $# -gt 0 ]]; do
    case "$1" in --timeout) TIMEOUT="$2"; shift 2 ;; *) names+=("$1"); shift ;; esac
  done
  [[ ${#names[@]} -gt 0 ]] || { echo "usage: swarm wait <name>... [--timeout MS]" >&2; exit 2; }
  local n st rc=0 seq0 f
  for n in "${names[@]}"; do
    f="$(seq_file "$n")"; seq0=0
    if [[ -f "$f" ]]; then seq0="$(cat "$f")"; else
      # no prompt recorded through swarm: trust herdr's settled wait
      "$H" agent wait "$n" --until idle --until done --until blocked --timeout "$TIMEOUT" >/dev/null 2>&1 || { echo "=== $n: wait timed out or agent gone" >&2; rc=1; continue; }
      seq0=-9
    fi
    wait_settled "$n" "$seq0" "$TIMEOUT"; case $? in
      1) echo "=== $n: agent gone" >&2; rc=1; continue ;;
      2) echo "=== $n: TIMEOUT after ${TIMEOUT}ms (still $("$H" agent get "$n" | jq -r .result.agent.agent_status))" >&2; rc=1; continue ;;
    esac
    rm -f "$f"
    st="$("$H" agent get "$n" 2>/dev/null | jq -r .result.agent.agent_status)"
    echo "=== $n: $st"
    [[ "$st" == blocked ]] && echo "(blocked: it is showing a question/approval UI — read it and tell the user)"
    "$H" agent read "$n" --source recent-unwrapped --lines 150 2>/dev/null | grep -v '^\s*$' | grep -v '^─*$' || true
  done
  return $rc
}

# swarm prompt <name> "<text>" [--wait] [--timeout MS]
cmd_prompt() {
  local NAME="" TEXT="" WAIT=0 TIMEOUT=1800000
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) WAIT=1; shift ;; --timeout) TIMEOUT="$2"; shift 2 ;;
      *) if [[ -z "$NAME" ]]; then NAME="$1"; elif [[ -z "$TEXT" ]]; then TEXT="$1"; else echo "unexpected arg: $1" >&2; exit 2; fi; shift ;;
    esac
  done
  [[ -n "$NAME" && -n "$TEXT" ]] || { echo 'usage: swarm prompt <name> "<text>" [--wait] [--timeout MS]' >&2; exit 2; }
  note_prompt "$NAME"
  "$H" agent prompt "$NAME" "$TEXT" >/dev/null || exit 1
  echo "prompt sent to $NAME"
  (( WAIT )) && cmd_wait "$NAME" --timeout "$TIMEOUT"
  return 0
}

# ==============================================================================
cmd_args() {
  [[ $# -eq 1 ]] || { echo "usage: swarm args <type>" >&2; exit 2; }
  require_type "$1"
  local promptf; promptf="$(mktemp -t swarm-prompt.XXXXXX)"
  body "$(type_file "$1")" > "$promptf"
  build_pi_args "$1" "$promptf"
  printf '%s\n' ${PI_ARGS[@]+"${PI_ARGS[@]}"}
  rm -f -- "$promptf"
}

cmd_types() {
  if [[ "${1:-}" == "--json" ]]; then
    local t f caps verdict
    for t in $(list_types); do
      [[ "$t" == "orchestrator" ]] && continue
      f="$(type_file "$t")"
      caps="$(norm_list "$(fm "$f" caps)")"; verdict="$(fm "$f" verdict)"
      jq -n --arg type "$t" --arg description "$(fm "$f" description)" \
            --arg use_for "$(fm "$f" use_for)" --arg caps "$caps" --arg verdict "$verdict" \
            --arg model "$(fm "$f" model)" --arg thinking "$(fm "$f" thinking)" \
            '{type:$type, description:$description, use_for:$use_for,
              caps:($caps | split(",") | map(select(. != ""))),
              verdict:($verdict == "required"), model:$model, thinking:$thinking}'
    done | jq -s '.'
    return 0
  fi
  printf "%-14s %-44s %s\n" TYPE MODEL DESCRIPTION
  local t f
  for t in $(list_types); do
    f="$(type_file "$t")"
    printf "%-14s %-44s %s\n" "$t" "$(fm "$f" model) ($(fm "$f" thinking))" "$(fm "$f" description)"
  done
}

cmd_ls() {
  local tab="${HERDR_TAB_ID:-}"
  "$H" agent list | jq -r --arg tab "$tab" '
    .result.agents[] | select(.name != null) | select($tab == "" or .tab_id == $tab)
    | "\(.name)\t\(.agent_status)\t\(.pane_id)"' | column -t
}

cmd_close() {
  [[ $# -eq 1 ]] || { echo "usage: swarm close <name>" >&2; exit 2; }
  local pane; pane="$("$H" agent get "$1" | jq -r .result.agent.pane_id)"
  [[ -n "$pane" && "$pane" != null ]] || { echo "no live agent '$1'" >&2; exit 1; }
  [[ "$1" == "${SWARM_ORCHESTRATOR:-}" ]] && { echo "refusing to close the orchestrator" >&2; exit 1; }
  "$H" pane close "$pane" >/dev/null && echo "closed $1 ($pane)"
}

# ==============================================================================
sub="${1:-start}"; [[ $# -gt 0 ]] && shift || true
case "$sub" in
  start)  cmd_start "$@" ;;
  spawn)  cmd_spawn "$@" ;;
  types)  cmd_types "$@" ;;
  args)   cmd_args "$@" ;;
  ls)     cmd_ls ;;
  wait)   cmd_wait "$@" ;;
  prompt) cmd_prompt "$@" ;;
  close)  cmd_close "$@" ;;
  -h|--help|help) sed -n '2,25p' "$0" ;;
  --*)    cmd_start "$sub" "$@" ;;      # `swarm --goal ...` shorthand
  *)      echo "unknown command: $sub" >&2; sed -n '2,11p' "$0" >&2; exit 2 ;;
esac
